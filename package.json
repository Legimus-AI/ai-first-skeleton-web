{
	"name": "@repo/web",
	"version": "3.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite",
		"route:generate": "node ./scripts/generate-routes.mjs",
		"prebuild": "pnpm route:generate",
		"build": "vite build",
		"preview": "vite preview",
		"lint": "biome check src",
		"lint:fix": "biome check src --write",
		"format": "biome format src --write",
		"test": "vitest run --passWithNoTests",
		"test:arch": "vitest run --config vitest.config.arch.ts",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage --passWithNoTests",
		"pretypecheck": "pnpm route:generate",
		"typecheck": "tsc --noEmit",
		"verify": "biome check src && tsc --noEmit && vitest run --passWithNoTests",
		"prepare": "lefthook install"
	},
	"dependencies": {
		"@better-auth/oauth-provider": "1.7.7",
		"@fontsource-variable/onest": "^5.3.1",
		"@hookform/resolvers": "^5.9.1",
		"@phosphor-icons/react": "^2.1.10",
		"@radix-ui/react-alert-dialog": "^1.1.24",
		"@radix-ui/react-dialog": "^1.2.0",
		"@radix-ui/react-dropdown-menu": "^2.1.25",
		"@radix-ui/react-switch": "^1.3.8",
		"@radix-ui/react-tabs": "^1.1.22",
		"@radix-ui/react-tooltip": "^1.3.0",
		"@repo/shared": "workspace:*",
		"@tanstack/react-query": "^5.104.1",
		"@tanstack/react-router": "^1.170.41",
		"@tanstack/react-table": "^8.21.3",
		"better-auth": "1.7.7",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"cmdk": "^1.1.1",
		"react": "19.3.0",
		"react-dom": "19.3.0",
		"react-error-boundary": "^6.1.6",
		"react-hook-form": "^7.89.0",
		"react-remove-scroll": "^2.7.2",
		"sonner": "^2.0.8",
		"tailwind-merge": "^3.7.0",
		"tw-animate-css": "^1.4.0",
		"zod": "^4.6.5"
	},
	"commitlint": {
		"extends": [
			"@commitlint/config-conventional"
		]
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.15",
		"@commitlint/cli": "^21.2.3",
		"@commitlint/config-conventional": "^21.2.3",
		"@tailwindcss/vite": "^4.3.3",
		"@tanstack/router-devtools": "^1.167.2",
		"@tanstack/router-generator": "^1.167.40",
		"@tanstack/router-plugin": "^1.168.42",
		"@types/node": "^26.6.4",
		"@testing-library/react": "^16.3.3",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.1.2",
		"@vitest/coverage-v8": "^5.0.3",
		"jsdom": "^30.1.2",
		"lefthook": "^2.2.0",
		"tailwindcss": "^4.3.3",
		"typescript": "^7.0.2",
		"vite": "^8.3.3",
		"vitest": "^5.0.3"
	}
}
