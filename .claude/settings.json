{
  "permissions": {
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(!.env.example)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/arch-gate.sh\"",
            "timeout": 120,
            "statusMessage": "Running architecture tests before finishing..."
          }
        ]
      }
    ]
  }
}
